---
// src/pages/index.astro
import TierListApp from "../components/TierListApp.jsx";
import Layout from "../layouts/Layout.astro";

// Fetching top 20 Commanders from Scryfall
const response = await fetch(
  "https://api.scryfall.com/cards/search?q=is:commander+sort:edhrec",
);
const data = await response.json();
const commanders = data.data
  .slice(0, 20)
  .map((card: { id: any; name: any; image_uris: { art_crop: string } }) => ({
    id: card.id,
    name: card.name,
    image: card.image_uris?.art_crop,
  }));
---

<Layout title="MTG Commander Tier List">
  <main class="p-8 bg-slate-900 min-h-screen text-white">
    <h1 class="text-4xl font-bold mb-8 text-center">Commander Tier List</h1>

    {/* This is our interactive "Island" */}
    <TierListApp client:load initialCommanders={commanders} />
  </main>
</Layout>
