---
import Layout from "../layouts/Layout.astro";
import TierListApp from "../components/TierListApp.jsx";
import commanderConfig from "../data/commanders.json";

type Card = {
  id: string;
  name: string;
  image_uris?: {
    normal: string;
    small: string;
  };
  card_faces?: [
    {
      image_uris: {
        normal: string;
        small: string;
      };
    },
  ];
};

type CommanderCard = {
  id: number;
  name: string;
  image: string | undefined;
};

const identifiers = commanderConfig.map((c) => ({ id: c.scryfallId }));
const CHUNK_SIZE = 75;

// 1. Create the chunks
const chunks = [];
for (let i = 0; i < identifiers.length; i += CHUNK_SIZE) {
  chunks.push(identifiers.slice(i, i + CHUNK_SIZE));
}

// 2. Map chunks to fetch promises
const requestPromises = chunks.map(async (chunk, index) => {
  // Optional: Stagger the start of each request by 100ms
  // to stay in Scryfall's good graces.
  await new Promise((resolve) => setTimeout(resolve, index * 100));

  const response = await fetch("https://api.scryfall.com/cards/collection", {
    method: "POST",
    headers: {
      "Content-Type": "application/json",
      "User-Agent": "CommanderTierList/1.0",
    },
    body: JSON.stringify({ identifiers: chunk }),
  });

  if (!response.ok) {
    let errorDetails = "";
    try {
      // Scryfall usually returns a JSON object with a "details" field on error
      const errorJson = await response.json();
      errorDetails = errorJson.details || JSON.stringify(errorJson);
    } catch (e) {
      // Fallback if the response body isn't valid JSON
      errorDetails = await response.text();
    }

    throw new Error(`Scryfall API error [${response.status}]: ${errorDetails}`);
  }

  return response.json();
});

// 3. Wait for all requests to finish
const results = await Promise.allSettled(requestPromises);

// 4. Process the successful results
const allCards: Card[] = results.flatMap((result) => {
  if (result.status === "fulfilled") {
    // result.value is the JSON data returned from the successful fetch
    return result.value.data;
  } else {
    // Log the error for the specific chunk that failed
    console.error("A chunk failed to fetch:", result.reason);
    return []; // Return an empty array so flatMap simply skips this chunk
  }
});

// 5. Map the API data back to the CommanderCard format
const commanders: CommanderCard[] = allCards
  .map((card: Card) => {
    const commanderId = commanderConfig.find(
      (c) => c.scryfallId === card.id,
    )?.id;

    if (!commanderId) {
      console.error(`Could not find commander ID for ${card.name}`);
      return null;
    }

    if (card.card_faces?.length) {
      return {
        id: commanderId,
        name: card.name,
        // We use 'normal' size for better quality in the tier list
        image: card.card_faces[0].image_uris?.normal || card.image_uris?.small,
      };
    } else {
      return {
        id: commanderId,
        name: card.name,
        // We use 'normal' size for better quality in the tier list
        image: card.image_uris?.normal || card.image_uris?.small,
      };
    }
  })
  .filter((c): c is CommanderCard => c !== null);
---

<Layout title="Commander Tier List">
  <main
    class="px-8 py-4 min-h-screen bg-linear-to-b from-ctp-base to-ctp-mantle"
  >
    <header class="mb-4 text-center">
      <h1 class="text-5xl font-black tracking-tighter text-ctp-blue">
        Commander Tier List
      </h1>
    </header>

    <TierListApp client:load initialCommanders={commanders} />
  </main>
</Layout>
