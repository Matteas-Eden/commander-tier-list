---
import Layout from "../layouts/Layout.astro";
import TierListApp from "../components/TierListApp.jsx";
import commanderConfig from "../data/commanders.json";

type Card = {
  id: string;
  name: string;
  image_uris?: {
    normal: string;
    small: string;
  };
  card_faces?: [
    {
      image_uris: {
        normal: string;
        small: string;
      };
    },
  ];
};

// Prepare the request for Scryfall's collection endpoint
const identifiers = commanderConfig.map((c) => ({ id: c.scryfallId }));

const response = await fetch("https://api.scryfall.com/cards/collection", {
  method: "POST",
  headers: { "Content-Type": "application/json" },
  body: JSON.stringify({ identifiers }),
});

const data = await response.json();

// Map the API data back to the format your React component expects
const commanders: Card[] = data.data.map((card: Card) => {
  if (card.card_faces?.length) {
    return {
      id: commanderConfig.find((c) => c.scryfallId === card.id)?.id,
      name: card.name,
      // We use 'normal' size for better quality in the tier list
      image: card.card_faces[0].image_uris?.normal || card.image_uris?.small,
    };
  } else {
    return {
      id: commanderConfig.find((c) => c.scryfallId === card.id)?.id,
      name: card.name,
      // We use 'normal' size for better quality in the tier list
      image: card.image_uris?.normal || card.image_uris?.small,
    };
  }
});
---

<Layout title="Astro MTG Tier List">
  <main
    class="px-8 py-4 min-h-screen bg-[radial-gradient(ellipse_at_top,var(--tw-gradient-stops))] from-slate-900 via-purple-900/20 to-black text-white bg-slate-800"
  >
    <header class="mb-4 text-center">
      <h1
        class="text-5xl font-black tracking-tighter text-transparent bg-clip-text bg-linear-to-r from-purple-400 to-pink-600"
      >
        Commander Tier List
      </h1>
    </header>

    <TierListApp client:load initialCommanders={commanders} />
  </main>
</Layout>
